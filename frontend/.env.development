# Frontend env — DEVELOPMENT (used by `npm run dev`).
# Empty VITE_API_URL => requests go to /api and are handled by the Vite dev proxy.
VITE_API_URL=

# Cloudflare Turnstile site key (login bot protection). Empty = widget hidden.
# Cloudflare's always-pass TEST key — pairs with the backend's test secret
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA in backend/.env.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
