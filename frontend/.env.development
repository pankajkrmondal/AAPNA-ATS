# Frontend env — DEVELOPMENT (used by `npm run dev`).
# Empty VITE_API_URL => requests go to /api and are handled by the Vite dev proxy.
VITE_API_URL=

# Cloudflare Turnstile site key (login bot protection). Empty = widget hidden.
# Local dev MUST use Cloudflare's dummy pair (always passes, shows a "testing
# only" banner) because the dashboard does not accept localhost as a hostname.
# Pair with TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA in
# backend/.env.development. Real keys are for staging/production envs only.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA


VERIFY_EMAIL=saukumar
VERIFY_PASSWORD=Ats@123
