# Frontend env — STAGING (mode: staging, used by `npm run build:staging`)
# Backend origin the built app talks to. The client appends /api to this.
# VITE_ vars are baked into the bundle and are public — no secrets.
VITE_API_URL=https://ats-staging.aapnainfotech.com

# Cloudflare Turnstile site key (login bot protection). Empty = widget hidden.
# VITE_ vars are public; the SECRET key belongs in the backend env only.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAD26qcVPjNTsIoU7

# Forms & Links (L08): show the menu item and its shortcuts. The page works at
# /forms-links either way. Off in production until HR signs off the menu slot.
VITE_FORMS_LINKS_ENABLED=true
