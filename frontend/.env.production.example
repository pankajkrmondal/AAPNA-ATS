# Frontend env — PRODUCTION (mode: production, used by `npm run build:prod`)
# Backend origin the built app talks to. The client appends /api to this.
# VITE_ vars are baked into the bundle and are public — no secrets.
VITE_API_URL=https://ats.aapnainfotech.com

# Forms & Links (L08): menu item and shortcuts. Off until HR signs off the menu slot.
VITE_FORMS_LINKS_ENABLED=false
