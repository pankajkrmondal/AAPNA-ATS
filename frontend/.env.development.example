# Frontend env — DEVELOPMENT (mode: development, used by `npm run dev`)
# Leave VITE_API_URL empty to use the Vite dev proxy (/api -> http://localhost:5000).
# Only VITE_-prefixed vars are exposed to the client bundle. Do NOT put secrets here.
VITE_API_URL=

# Forms & Links (L08): show the menu item and its shortcuts. The page works at
# /forms-links either way. Off in production until HR signs off the menu slot.
VITE_FORMS_LINKS_ENABLED=true
